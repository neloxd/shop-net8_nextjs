          <mxGeometry as="geometry" x="687" y="558" width="276" height="84" />
        </mxCell>
        <mxCell id="18" value="6. Firmar JWT HS256 · 60 minutos" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf5f3;strokeColor=#e0d8ed;fontColor=#30233f;fontSize=14;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="687" y="665" width="276" height="58" />
        </mxCell>
        <mxCell id="19" value="7. 200 { token, expiresAt, usuario }" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#79698e;strokeWidth=2;dashed=1;fontSize=14;fontFamily=Arial;fontColor=#675778;labelBackgroundColor=#f8f7fc;" edge="1" parent="1">
