            <mxPoint as="targetPoint" x="140" y="900" />
          </mxGeometry>
        </mxCell>
        <mxCell id="22" value="10. Redirigir a /tiendas&lt;br&gt;Validar sesión con GET /api/auth/me" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#e0d8ed;fontColor=#30233f;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="934" width="270" height="67" />
        </mxCell>
        <mxCell id="23" value="Alternativas: credenciales inválidas / usuario inactivo → 401. Datos inválidos → 400.&lt;br&gt;Más de 20 intentos por minuto e IP del llamador → 429. Origin distinto → 403 en Next.js.&lt;br&gt;En esta demo, las peticiones del BFF comparten la misma IP hacia la API." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff4e8;strokeColor=#f1d6b4;fontColor=#30233f;fontSize=14;fontFamily=Arial;align=left;verticalAlign=middle;spacing=16;fontStyle=0;" vertex="1" parent="1">
