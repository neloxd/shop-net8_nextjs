            <mxPoint as="targetPoint" x="485" y="770" />
          </mxGeometry>
        </mxCell>
        <mxCell id="20" value="8. Guardar JWT en cookie HttpOnly&lt;br&gt;SameSite=Strict; Secure con HTTPS" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f1eafa;strokeColor=#e0d8ed;fontColor=#30233f;fontSize=13;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="354" y="792" width="262" height="64" />
        </mxCell>
        <mxCell id="21" value="9. 200 { usuario } + Set-Cookie&lt;br&gt;El cuerpo al navegador no expone JWT" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#79698e;strokeWidth=2;dashed=1;fontSize=13;fontFamily=Arial;fontColor=#675778;labelBackgroundColor=#f8f7fc;" edge="1" parent="1">
